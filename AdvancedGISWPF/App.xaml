<Application x:Class="AdvancedGISWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:fluent="urn:fluent-ribbon"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                
                <!-- Fluent Ribbon -->
                <fluent:ThemeManager />
                
                <!-- Custom Styles -->
                <ResourceDictionary Source="Styles/ApplicationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Colors -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3"/>
            <SolidColorBrush x:Key="SecondaryBrush" Color="#009688"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF9800"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FFC107"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#00BCD4"/>
            
            <!-- Global Fonts -->
            <FontFamily x:Key="MainFont">Segoe UI</FontFamily>
            <FontFamily x:Key="MonospaceFont">Consolas</FontFamily>
            
            <!-- Global Sizes -->
            <x:Double x:Key="SmallSpacing">4</x:Double>
            <x:Double x:Key="MediumSpacing">8</x:Double>
            <x:Double x:Key="LargeSpacing">16</x:Double>
            <x:Double x:Key="ExtraLargeSpacing">24</x:Double>
            
            <!-- Chart Colors -->
            <SolidColorBrush x:Key="ChartColor1" Color="#FF6B6B"/>
            <SolidColorBrush x:Key="ChartColor2" Color="#4ECDC4"/>
            <SolidColorBrush x:Key="ChartColor3" Color="#45B7D1"/>
            <SolidColorBrush x:Key="ChartColor4" Color="#96CEB4"/>
            <SolidColorBrush x:Key="ChartColor5" Color="#FFEAA7"/>
            <SolidColorBrush x:Key="ChartColor6" Color="#DDA0DD"/>
            <SolidColorBrush x:Key="ChartColor7" Color="#98D8C8"/>
            <SolidColorBrush x:Key="ChartColor8" Color="#F7DC6F"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
