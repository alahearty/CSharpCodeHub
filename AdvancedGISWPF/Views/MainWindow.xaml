<Window x:Class="AdvancedGISWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:fluent="urn:fluent-ribbon"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        Title="Advanced GIS WPF Application - Geographic Information System"
        Height="900" Width="1400"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <materialDesign:Card Grid.Row="0" Padding="0" Margin="0">
            <Menu Background="{DynamicResource MaterialDesignToolBarBackground}">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Project" 
                              Command="{Binding NewProjectCommand}"/>
                    <MenuItem Header="_Open Project"
                              Command="{Binding OpenProjectCommand}"/>
                    <MenuItem Header="_Save Project"
                              Command="{Binding SaveProjectCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Import Data"
                              Command="{Binding ImportDataCommand}"/>
                    <MenuItem Header="_Export Data"
                              Command="{Binding ExportDataCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Settings"
                              Command="{Binding SettingsCommand}"/>
                    <MenuItem Header="E_xit"
                              Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="_Map">
                    <MenuItem Header="_Zoom In" Command="{Binding ZoomInCommand}"/>
                    <MenuItem Header="Zoom O_ut" Command="{Binding ZoomOutCommand}"/>
                    <MenuItem Header="_Pan" Command="{Binding PanCommand}"/>
                    <MenuItem Header="Full _Extent" Command="{Binding FullExtentCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Add Layer" Command="{Binding AddLayerCommand}"/>
                    <MenuItem Header="_Remove Layer" Command="{Binding RemoveLayerCommand}"/>
                    <MenuItem Header="Layer _Properties" Command="{Binding LayerPropertiesCommand}"/>
                </MenuItem>
                <MenuItem Header="_Analysis">
                    <MenuItem Header="_Buffer" Command="{Binding BufferCommand}"/>
                    <MenuItem Header="_Intersect" Command="{Binding IntersectCommand}"/>
                    <MenuItem Header="_Union" Command="{Binding UnionCommand}"/>
                    <MenuItem Header="_Distance" Command="{Binding DistanceCommand}"/>
                    <Separator/>
                    <MenuItem Header="Descriptive _Stats" Command="{Binding DescriptiveStatsCommand}"/>
                    <MenuItem Header="Spatial _Autocorrelation" Command="{Binding SpatialAutocorrCommand}"/>
                    <MenuItem Header="_Hot Spot Analysis" Command="{Binding HotSpotCommand}"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Print Layout" Command="{Binding PrintLayoutCommand}"/>
                    <MenuItem Header="Export _Map" Command="{Binding ExportMapCommand}"/>
                    <Separator/>
                    <MenuItem Header="Layer _Manager" Command="{Binding LayerManagerCommand}"/>
                    <MenuItem Header="_Attribute Table" Command="{Binding AttributeTableCommand}"/>
                    <MenuItem Header="_Toolbox" Command="{Binding ToolboxCommand}"/>
                </MenuItem>
            </Menu>
        </materialDesign:Card>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="1" Background="{DynamicResource MaterialDesignToolBarBackground}">
            <ToolBar Background="Transparent" BorderThickness="0">
                <Button Content="🗺️ Map" Command="{Binding ShowMapCommand}" 
                        Style="{StaticResource MaterialDesignToolButton}"/>
                <Button Content="📊 Charts" Command="{Binding ShowChartsCommand}" 
                        Style="{StaticResource MaterialDesignToolButton}"/>
                <Button Content="📋 Data" Command="{Binding ShowDataCommand}" 
                        Style="{StaticResource MaterialDesignToolButton}"/>
                <Button Content="🔍 Analysis" Command="{Binding ShowAnalysisCommand}" 
                        Style="{StaticResource MaterialDesignToolButton}"/>
                <Separator/>
                <Button Content="⚙️ Settings" Command="{Binding SettingsCommand}" 
                        Style="{StaticResource MaterialDesignToolButton}"/>
                <Button Content="❓ Help" Command="{Binding HelpCommand}" 
                        Style="{StaticResource MaterialDesignToolButton}"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" x:Name="MainContentArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Layer Manager -->
            <materialDesign:Card Grid.Column="0" Margin="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Layer Manager" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,8"/>
                    
                    <TreeView Grid.Row="1" x:Name="LayerTreeView" 
                              ItemsSource="{Binding Layers}"
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Sublayers}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsVisible}" 
                                              Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <!-- Center Panel - Map View -->
            <materialDesign:Card Grid.Column="1" Margin="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Map Control Placeholder -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignDivider}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <TextBlock Text="🗺️ Map View Area" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            
                            <!-- Map Controls Overlay -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Margin="8" Orientation="Horizontal">
                                <Button Content="🔍" Command="{Binding ZoomInCommand}" 
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Margin="2"/>
                                <Button Content="🔎" Command="{Binding ZoomOutCommand}" 
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Margin="2"/>
                                <Button Content="✋" Command="{Binding PanCommand}" 
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Margin="2"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Status Bar -->
                    <StatusBar Grid.Row="1" Background="{DynamicResource MaterialDesignToolBarBackground}">
                        <StatusBarItem>
                            <TextBlock Text="Ready" x:Name="StatusText"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock Text="Scale: 1:1000" x:Name="ScaleText"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock Text="Coordinates: 0, 0" x:Name="CoordinatesText"/>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>
            </materialDesign:Card>

            <!-- Right Panel - Properties/Charts -->
            <materialDesign:Card Grid.Column="2" Margin="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Properties &amp; Charts" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,8"/>
                    
                    <TabControl Grid.Row="1" x:Name="PropertiesTabControl">
                        <TabItem Header="Properties">
                            <ScrollViewer>
                                <StackPanel>
                                    <TextBlock Text="Layer Properties" 
                                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding SelectedLayerName}" 
                                             materialDesign:HintAssist.Hint="Layer Name"
                                             Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding SelectedLayerDescription}" 
                                             materialDesign:HintAssist.Hint="Description"
                                             Margin="0,0,0,8"/>
                                    <ComboBox materialDesign:HintAssist.Hint="Geometry Type"
                                              ItemsSource="{Binding GeometryTypes}"
                                              SelectedItem="{Binding SelectedGeometryType}"
                                              Margin="0,0,0,8"/>
                                    <Button Content="Apply Changes" 
                                            Command="{Binding ApplyPropertiesCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        
                        <TabItem Header="Charts">
                            <ScrollViewer>
                                <StackPanel>
                                    <TextBlock Text="Data Visualization" 
                                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                               Margin="0,0,0,8"/>
                                    
                                    <!-- LiveCharts Example -->
                                    <lvc:CartesianChart Height="200" Margin="0,0,0,8">
                                        <lvc:CartesianChart.Series>
                                            <lvc:LineSeries Title="Temperature Trend" 
                                                            Values="{Binding TemperatureData}"
                                                            PointGeometry="{x:Null}"
                                                            LineSmoothness="0.5"/>
                                        </lvc:CartesianChart.Series>
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Title="Time" Labels="{Binding TimeLabels}"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Temperature (°C)" LabelFormatter="{Binding TemperatureFormatter}"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                    
                                    <!-- OxyPlot Example -->
                                    <oxy:PlotView Height="200" Model="{Binding SpatialDataPlot}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        
                        <TabItem Header="Statistics">
                            <ScrollViewer>
                                <StackPanel>
                                    <TextBlock Text="Statistical Summary" 
                                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                               Margin="0,0,0,8"/>
                                    
                                    <DataGrid ItemsSource="{Binding StatisticsData}" 
                                              AutoGenerateColumns="False" 
                                              Height="300"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{DynamicResource MaterialDesignToolBarBackground}">
            <StatusBarItem>
                <TextBlock Text="Advanced GIS WPF Application v1.0" 
                           FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Database: Connected" x:Name="DatabaseStatusText"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Memory Usage: 128 MB" x:Name="MemoryStatusText"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentDateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                           x:Name="DateTimeText"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
