@startuml TextAdventureGame_UseCase_Diagram

' Text Adventure Game Use Case Diagram

actor Player
actor GameSystem

rectangle "Text Adventure Game" {
    usecase "Start Game" as UC1
    usecase "Move to Location" as UC2
    usecase "Take Item" as UC3
    usecase "Use Item" as UC4
    usecase "View Inventory" as UC5
    usecase "View Location" as UC6
    usecase "Process Command" as UC7
    usecase "Take Damage" as UC8
    usecase "Heal" as UC9
    usecase "Show Help" as UC10
}

Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4
Player --> UC5
Player --> UC6
Player --> UC10

GameSystem --> UC7
GameSystem --> UC8
GameSystem --> UC9

UC2 ..> UC6 : <<include>>
UC3 ..> UC5 : <<extend>>
UC4 ..> UC5 : <<extend>>
UC7 ..> UC2 : <<extend>>
UC7 ..> UC3 : <<extend>>
UC7 ..> UC4 : <<extend>>

@enduml

