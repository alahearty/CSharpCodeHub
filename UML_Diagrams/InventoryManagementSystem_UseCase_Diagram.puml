@startuml InventoryManagementSystem_UseCase_Diagram

' Inventory Management System Use Case Diagram

actor Manager
actor Employee
actor System

rectangle "Inventory Management System" {
    usecase "Add Product" as UC1
    usecase "Update Product Info" as UC2
    usecase "Update Stock" as UC3
    usecase "Update Price" as UC4
    usecase "Update Cost" as UC5
    usecase "View Product" as UC6
    usecase "Check Stock Status" as UC7
    usecase "View Low Stock Items" as UC8
    usecase "View Out of Stock Items" as UC9
    usecase "Calculate Profit Margin" as UC10
    usecase "Calculate Total Value" as UC11
}

Manager --> UC1
Manager --> UC2
Manager --> UC4
Manager --> UC5
Manager --> UC6
Manager --> UC7
Manager --> UC8
Manager --> UC9
Manager --> UC10
Manager --> UC11

Employee --> UC3
Employee --> UC6
Employee --> UC7

System --> UC7
System --> UC8
System --> UC9
System --> UC10
System --> UC11

UC3 ..> UC7 : <<include>>
UC4 ..> UC10 : <<include>>
UC5 ..> UC10 : <<include>>
UC6 ..> UC7 : <<extend>>
UC6 ..> UC10 : <<extend>>
UC6 ..> UC11 : <<extend>>

@enduml

